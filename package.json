{
  "name": "@jordan-choi/mcp-server-youtube-transcript",
  "version": "0.1.1",
  "description": "MCP server that returns YouTube video transcripts via yt-dlp, with SponsorBlock-based ad filtering and per-sentence timestamps. Forked from @kimtaeyoon83/mcp-server-youtube-transcript.",
  "license": "MIT",
  "author": "Jordan Choi",
  "homepage": "https://github.com/jordan-choi/mcp-server-youtube-transcript#readme",
  "bugs": {
    "url": "https://github.com/jordan-choi/mcp-server-youtube-transcript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordan-choi/mcp-server-youtube-transcript.git"
  },
  "access": "public",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "bin": {
    "mcp-server-youtube-transcript": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/*.js",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "mcp-evals": "^1.0.18"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "shx": "^0.3.4",
    "tsx": "^4.21.0",
    "typescript": "^5.6.2"
  }
}
